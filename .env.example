# Optional approved OpenAI-compatible endpoint supporting JSON-schema outputs.
# No paid model is selected automatically.
QEI_MODEL_BASE_URL=
QEI_MODEL_NAME=
QEI_MODEL_API_KEY=
# Public Streamlit demo grants no private scopes. A project selector is not login.
# Optional local index path; never commit private data or generated private indexes.
QEI_CORPUS_PATH=
QEI_LOG_LEVEL=INFO
# Do not enable external tracing for private source content without approval.
LANGSMITH_TRACING=false
